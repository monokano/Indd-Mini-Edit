        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動保存は空です"
          }
        }
      }
    },
    "The document window is minimized in the Dock.": {
      "comment": "Send message: the active document window is minimized in the Dock",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドキュメントウインドウがDockにしまわれています"
          }
        }
      }
    },
    "There is no InDesign document.": {
      "comment": "Send message: InDesign has no document",
