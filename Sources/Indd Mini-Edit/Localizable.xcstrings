{
  "sourceLanguage": "en",
  "strings": {
    "About Indd Mini-Edit": {
      "comment": "App menu",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Indd Mini-Editについて"
          }
        }
      }
    },
    "Adjust Position": {
      "comment": "Context menu > Position",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "位置を調整"
          }
        }
      }
    },
    "Allow Indd Mini-Edit to control InDesign in System Settings > Privacy & Security > Automation.": {
      "comment": "Send message: Apple Events permission denied",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「システム設定」>「プライバシーとセキュリティ」>「オートメーション」で、Indd Mini-EditにInDesignの操作を許可してください"
          }
        }
      }
    },
    "Back": {
      "comment": "Help window toolbar (accessibility)",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "戻る"
          }
        }
      }
    },
    "Bring InDesign to the front.": {
      "comment": "Send message: frontmost app is not InDesign",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "InDesignを最前面にしてください"
          }
        }
      }
    },
    "Close": {
      "comment": "File menu",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じる"
          }
        }
      }
    },
    "Convert Alphanumerics to Full-Width": {
      "comment": "Context menu",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "英数字を全角に"
          }
        }
      }
    },
    "Convert Alphanumerics to Half-Width": {
      "comment": "Context menu",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "英数字を半角に"
          }
        }
      }
    },
    "Copy": {
      "comment": "Edit menu",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コピー"
          }
        }
      }
    },
    "Couldn't send the text to InDesign.": {
      "comment": "Send message: Apple Event failed or timed out",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "InDesignにテキストを送れませんでした"
          }
        }
